# Copy this file to ".env" (same folder as price_tracker.py) and paste your real keys.
# .env is git-ignored, so the keys stay on your computer. On GitHub, use repository secrets instead.
SERPAPI_KEY=paste_your_serpapi_key_here
EBAY_CLIENT_ID=paste_your_ebay_app_id_here
EBAY_CLIENT_SECRET=paste_your_ebay_cert_id_here
