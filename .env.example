# Copy this file to ".env" (same folder as price_tracker.py) and paste your real keys.
# .env is git-ignored, so the keys stay on your computer. On GitHub, use repository secrets instead.
# Every key is OPTIONAL - a missing key is reported as api_unavailable and the other sources keep running.
SERPAPI_KEY=paste_your_serpapi_key_here
# eBay Browse API (approval pending is fine - leave blank until the production keyset is active)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# PRICE_TRACKER_BROWSER=off      # disable the Playwright fallback
# PRICE_TRACKER_WORKERS=3        # conservative parallelism (per-domain limits always apply)
